# Öffentliche Adresse der App (für Cookies und den Free-Homes-Login)
BASE_URL=https://www.investment-arena.com
PORT=8080

# Kostenloser Schlüssel von https://finnhub.io (US-Kurse in Echtzeit, Insider, Analysten, Quartalstermine)
FINNHUB_KEY=

# Login über Free Homes (Keycloak). Leer lassen, bis der Client in Keycloak angelegt ist.
FREEHOMES_ISSUER=https://keycloak.free-homes.de/realms/freehomes
FREEHOMES_CLIENT_ID=
FREEHOMES_CLIENT_SECRET=
# Diese Adressen werden beim Login über Free Homes Admin (TRCM Portfolio pflegen), kommagetrennt
ADMIN_EMAILS=

# Postings von Florian Homm aus Free Homes (Kategorie "florian-homm" der App). Die Arena liest sie alle 30 Minuten.
# Entweder ein fester Zugangsschlüssel von Free Homes ...
FREEHOMES_FEED_TOKEN=
# ... oder ein Free-Homes-Konto, mit dem sich die Arena bei Keycloak anmeldet (Direct Access Grants für den Client nötig)
FREEHOMES_FEED_USER=
FREEHOMES_FEED_PASS=
FREEHOMES_FEED_CLIENT_ID=public-client
# Ersatzweise ein RSS-, Atom- oder JSON-Feed
FREEHOMES_NEWS_URL=
# RSS-Feeds für „Aktuell“ (nur Überschrift, Quelle, Link), kommagetrennt
NEWS_FEEDS=https://www.tagesschau.de/wirtschaft/index~rss2.xml
# Stimmen im Smart-Money-Radar: Notenbanken und Research als „Name|URL“, kommagetrennt
SMART_FEEDS=Fed|https://www.federalreserve.gov/feeds/press_all.xml,EZB|https://www.ecb.europa.eu/rss/press.html,Hussman Funds|https://www.hussmanfunds.com/feed/,MarketWatch|https://feeds.content.dowjones.io/public/rss/mw_realtimeheadlines
# Vertiefung im Bereich Lernen: Free Homes Academy
ACADEMY_URL=https://app.free-homes.de/module/fh-academy
# Vertiefung: Standardlink zum Börsenbrief an jeder Meldung
BOERSENBRIEF_URL=https://homm-longshort.com/

# Großinvestoren aus SEC-13F-Meldungen. Die SEC verlangt Name und Kontakt-E-Mail im User-Agent.
SEC_USER_AGENT=Investment Arena kontakt@ihre-domain.de
# 0 = Großinvestoren ausschalten
GURUS=1

# 1 = keine externen Kursabrufe (Offline-Demo, Tests)
MARKET_OFFLINE=0
# 0 = keine Beispiel-Community (Gründungsmitglieder) anlegen
SEED_BOTS=1
