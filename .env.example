# Öffentliche Adresse der App (für Cookies und den Free-Homes-Login)
BASE_URL=https://www.investment-arena.com
PORT=8080

# Kostenloser Schlüssel von https://finnhub.io (US-Kurse in Echtzeit, Insider, Analysten, Quartalstermine)
FINNHUB_KEY=

# Login über Free Homes (Keycloak). Leer lassen, bis der Client in Keycloak angelegt ist.
FREEHOMES_ISSUER=https://keycloak.free-homes.de/realms/freehomes
FREEHOMES_CLIENT_ID=
FREEHOMES_CLIENT_SECRET=

# 1 = keine externen Kursabrufe (Offline-Demo, Tests)
MARKET_OFFLINE=0
# 0 = keine Beispiel-Community anlegen
SEED_BOTS=1
